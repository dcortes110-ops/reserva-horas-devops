# Copie este archivo como .env y ajuste los valores si lo necesita:
#   cp .env.example .env
# NUNCA suba el archivo .env real al repositorio (está en .gitignore).

# Puerto del equipo local donde se publica el servicio
APP_PORT=8080

# Zona horaria del contenedor
TZ=America/Santiago

# Ejemplo de variable sensible (solo marcador de posición, sin valor real)
# API_KEY=CAMBIAR_POR_VALOR_REAL_SOLO_EN_.env_LOCAL
